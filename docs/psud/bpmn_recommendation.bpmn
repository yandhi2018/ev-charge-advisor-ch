<bpmn:sequenceFlow id="f8" sourceRef="t6" targetRef="g2"/>
<bpmn:sequenceFlow id="f9" sourceRef="g2" targetRef="t7"/>
<bpmn:sequenceFlow id="f10" sourceRef="t7" targetRef="g3"/>
<bpmn:sequenceFlow id="f11" sourceRef="g3" targetRef="t9" name="да"/>
<bpmn:sequenceFlow id="f12" sourceRef="g3" targetRef="t8" name="нет"/>
<bpmn:sequenceFlow id="f13" sourceRef="t8" targetRef="g4"/>
<bpmn:sequenceFlow id="f14" sourceRef="g4" targetRef="t7" name="да"/>
<bpmn:sequenceFlow id="f15" sourceRef="g4" targetRef="end_none" name="нет"/>
<bpmn:sequenceFlow id="f16" sourceRef="t9" targetRef="t10"/>
<bpmn:sequenceFlow id="f17" sourceRef="t10" targetRef="t11"/>
<bpmn:sequenceFlow id="f18" sourceRef="t11" targetRef="t12"/>
<bpmn:sequenceFlow id="f19" sourceRef="t12" targetRef="t13"/>
<bpmn:sequenceFlow id="f20" sourceRef="t13" targetRef="g5"/>
<bpmn:sequenceFlow id="f21" sourceRef="g5" targetRef="t15" name="да"/>
<bpmn:sequenceFlow id="f22" sourceRef="g5" targetRef="t14" name="нет"/>
<bpmn:sequenceFlow id="f23" sourceRef="t14" targetRef="t3"/>
<bpmn:sequenceFlow id="f24" sourceRef="t15" targetRef="end_ok"/>
<bpmn:dataObjectReference id="d_vehicle_ref" name="core.vehicle" dataObjectRef="d_vehicle"/><bpmn:dataObject id="d_vehicle"/>
<bpmn:dataObjectReference id="d_snapshot_ref" name="core.status_snapshot" dataObjectRef="d_snapshot"/><bpmn:dataObject id="d_snapshot"/>
<bpmn:dataObjectReference id="d_profile_ref" name="mart.evse_profile, weather_hourly" dataObjectRef="d_profile"/><bpmn:dataObject id="d_profile"/>
<bpmn:dataObjectReference id="d_log_ref" name="core.recommendation_request / item" dataObjectRef="d_log"/><bpmn:dataObject id="d_log"/>
</bpmn:process>
