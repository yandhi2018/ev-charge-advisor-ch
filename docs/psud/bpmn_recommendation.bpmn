<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="https://github.com/yandhi2018/ev-charge-advisor-ch">
<bpmn:collaboration id="collab"><bpmn:participant id="pool" name="EV Charge Advisor CH: подбор станции для зарядки" processRef="proc"/></bpmn:collaboration>
<bpmn:process id="proc" isExecutable="false"><bpmn:laneSet id="lanes"><bpmn:lane id="lane_driver" name="Водитель"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>t13</bpmn:flowNodeRef><bpmn:flowNodeRef>g5</bpmn:flowNodeRef><bpmn:flowNodeRef>t14</bpmn:flowNodeRef><bpmn:flowNodeRef>t15</bpmn:flowNodeRef><bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_app" name="Система (веб-приложение, рекомендатель)"><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>g2</bpmn:flowNodeRef><bpmn:flowNodeRef>t7</bpmn:flowNodeRef><bpmn:flowNodeRef>g3</bpmn:flowNodeRef><bpmn:flowNodeRef>t8</bpmn:flowNodeRef><bpmn:flowNodeRef>g4</bpmn:flowNodeRef><bpmn:flowNodeRef>t9</bpmn:flowNodeRef><bpmn:flowNodeRef>t10</bpmn:flowNodeRef><bpmn:flowNodeRef>t11</bpmn:flowNodeRef><bpmn:flowNodeRef>end_none</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_data" name="Хранилище и внешние источники"><bpmn:flowNodeRef>t5</bpmn:flowNodeRef><bpmn:flowNodeRef>t6</bpmn:flowNodeRef><bpmn:flowNodeRef>t12</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="start" name="Нужна зарядка"><bpmn:outgoing>f0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="t1" name="Выбрать автомобиль"><bpmn:incoming>f0</bpmn:incoming><bpmn:outgoing>f1</bpmn:outgoing><bpmn:dataInputAssociation id="a_d_vehicle"><bpmn:sourceRef>d_vehicle_ref</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:userTask>
<bpmn:userTask id="t2" name="Указать местоположение"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t3" name="Отправить запрос с фильтрами"><bpmn:incoming>f2</bpmn:incoming><bpmn:incoming>f23</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="t4" name="Проверить возраст снимка статусов"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g1" name="Снимок старше 5 мин?"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t5" name="Получить снимок EVSEStatus"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t6" name="Сохранить снимок (sp_apply_status_snapshot)"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:dataOutputAssociation id="a_d_snapshot"><bpmn:targetRef>d_snapshot_ref</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g2" name=""><bpmn:incoming>f6</bpmn:incoming><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t7" name="Подобрать совместимые точки (fn_compatible_evses)"><bpmn:incoming>f9</bpmn:incoming><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g3" name="Найдено ≥ 5 станций?"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:outgoing>f12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t8" name="Расширить радиус поиска"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g4" name="Радиус ≤ 50 км?"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing><bpmn:outgoing>f15</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t9" name="Рассчитать время в пути"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t10" name="Оценить вероятность свободной точки (модель B)"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing><bpmn:dataInputAssociation id="a_d_profile"><bpmn:sourceRef>d_profile_ref</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:serviceTask id="t11" name="Ранжировать по ожидаемому времени и сформировать пояснения"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t12" name="Записать журнал запроса"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing><bpmn:dataOutputAssociation id="a_d_log"><bpmn:targetRef>d_log_ref</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:userTask id="t13" name="Просмотреть рекомендации на карте"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="g5" name="Станция подходит?"><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing><bpmn:outgoing>f22</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="t14" name="Изменить фильтры"><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f23</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t15" name="Открыть маршрут к станции"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="end_ok" name="Станция выбрана"><bpmn:incoming>f24</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="end_none" name="Подходящих станций нет"><bpmn:incoming>f15</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f0" sourceRef="start" targetRef="t1"/>
<bpmn:sequenceFlow id="f1" sourceRef="t1" targetRef="t2"/>
<bpmn:sequenceFlow id="f2" sourceRef="t2" targetRef="t3"/>
<bpmn:sequenceFlow id="f3" sourceRef="t3" targetRef="t4"/>
<bpmn:sequenceFlow id="f4" sourceRef="t4" targetRef="g1"/>
