# Скопируйте в .env (scripts/init_db.ps1 делает это сам и генерирует пароли).
# .env в git не попадает.

# docker — PostgreSQL 17 в контейнере (docker-compose.yml), пароль суперпользователя генерируется;
# local  — установленный PostgreSQL, пароль суперпользователя спрашивается при init_db.
PG_MODE=docker
PG_HOST=127.0.0.1
PG_PORT=55432
PG_DB=evadvisor
PG_SUPERUSER_PASSWORD=

# Владелец схем и мигратор
PG_ADMIN_USER=ev_admin
PG_ADMIN_PASSWORD=

# Учётные записи приложения (по одной на роль, см. db/07_roles.sql)
PG_ENGINEER_USER=app_engineer
PG_ENGINEER_PASSWORD=
PG_ANALYST_USER=app_analyst
PG_ANALYST_PASSWORD=
PG_DRIVER_USER=app_driver
PG_DRIVER_PASSWORD=

# Каталог данных (raw-файлы, Parquet, артефакты). По умолчанию ./data
EVADVISOR_DATA_DIR=
